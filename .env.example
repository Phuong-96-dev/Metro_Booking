# Copy to .env in the project root, or set process environment variables.
# The application imports .env as Java properties. Do not wrap values in shell quotes.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=metro;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=replace-with-your-database-password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
GOOGLE_LINK_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google-link
SESSION_COOKIE_SECURE=false
AUTH_ALLOW_LEGACY_PASSWORDS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=25

# SePay. Use a bank short name supported by VietQR, for example Vietcombank.
SEPAY_ENABLED=false
SEPAY_BANK=Vietcombank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_PAYMENT_PREFIX=METRO
# Optional bank-specific memo prefix: SEVQR for VietinBank, or TKPxxx for memo-based VA.
SEPAY_TRANSFER_PREFIX=
# HMAC is recommended. API_KEY is supported for simpler testing.
SEPAY_WEBHOOK_AUTH_MODE=HMAC
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
SEPAY_WEBHOOK_MAX_AGE_SECONDS=300
